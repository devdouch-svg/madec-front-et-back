# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development                   # development | staging | production
APP_NAME="My Madec API"
APP_VERSION="1.0.0"
DEBUG=true
ENABLE_DOCS=true
LOG_TO_FILE=false
SECRET_KEY=change-me-to-a-very-long-random-secret-key-in-production

# ── Database — production (Docker) or local dev ───────────────────────────────
# Production (Docker on VPS): DB_HOST=mssql, MSSQL_DOCKER_NETWORK=my-madec-mssql_default
# Local dev (SQL Express):    DB_HOST=localhost\SQLEXPRESS, leave DB_USER/DB_PASSWORD empty
DB_HOST=localhost
DB_PORT=1433
DB_NAME=mymadec
DB_USER=sa
DB_PASSWORD=your_password_here
# Use 17 if 18 is not installed (Windows ODBC Data Sources)
DB_DRIVER=ODBC Driver 17 for SQL Server
# Docker network where the MSSQL container runs (production only)
# MSSQL_DOCKER_NETWORK=my-madec-mssql_default
# Full override (optional — overrides all DB_* vars above)
# DATABASE_URL=mssql+pyodbc://sa:password@localhost:1433/mymadec?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# ── Auth ──────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=24
ADMIN_EMAIL=admin@mymadec.com
# Production: set via GitHub secret ADMIN_INITIAL_PASSWORD (fixed login, not random)
# ADMIN_INITIAL_PASSWORD=YourSecurePassword1!

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Base URL for admin/web links in emails (production CI sets this from VPS_HOST:8034)
# FRONTEND_BASE_URL=http://your-server-ip:8034
# Mobile deep link for password-reset button in emails
MOBILE_RESET_DEEP_LINK=mymadec://reset-password

# ── File uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# ── Email (SMTP) — one value per GitHub secret in CI ─────────────────────────
# Gmail: use an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_NAME="My Madec"
SMTP_TLS=true
DISABLE_EMAIL=true
# Staging only — sends one test email on API boot (remove or leave empty in production)
# STARTUP_TEST_EMAIL=mohamedtaqysalmi@gmail.com

# ── Demo seed data (fake users, products, orders for testing) ─────────────────
SEED_DEMO=true
# Staging VPS: reload MADEC catalogue on each container start (see scripts/reset_madec_catalog.py)
RESET_MADEC_CATALOG=false

# ── Firebase (FCM) ────────────────────────────────────────────────────────────
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json
# Or embed JSON directly:
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# ── ETL Service token ─────────────────────────────────────────────────────────
# Generated on first run via init_db; override here to set a fixed token
ETL_SERVICE_TOKEN=

# ── Business rules ────────────────────────────────────────────────────────────
# Fallback fee rate on especes orders (0.25 = 25%). Once an admin sets the rate
# from the dashboard (Paiement page), the stored value takes precedence over this.
FIXEDTAX_RATE=0.0

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_RESET_PASSWORD=3/minute
RATE_LIMIT_CHANGE_PASSWORD=5/minute
